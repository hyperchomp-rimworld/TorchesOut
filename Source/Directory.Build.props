<Project>
  <!-- Keep MSBuild's intermediate files (obj/) out of the mod folder so they never get uploaded
       to the Workshop. Must be set here: MSBuild reads this file before the SDK is imported,
       and setting it in the .csproj is too late. -->
  <PropertyGroup>
    <BaseIntermediateOutputPath>$(HOME)/Library/Caches/TorchesOut/obj/</BaseIntermediateOutputPath>
  </PropertyGroup>
</Project>
